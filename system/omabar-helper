#!/usr/bin/python3 -IS
"""Omabar's root helper. Runs through pkexec; installed root-owned at
/usr/local/libexec/omabar-helper. It never reads files from the plugin
folder: everything arrives on stdin and is checked before it is written.

  omabar-helper config [--live]   install /etc/tiny-dfr/config.toml
        stdin: a config generated by Omabar (first line marker, 64 KiB cap).
        --live rewrites the file in place: tiny-dfr's inotify watch on the file
        (IN_CLOSE) reloads it without a restart. Without --live the file is
        replaced and tiny-dfr restarted.
  omabar-helper icons             replace the set of /etc/tiny-dfr/omabar_*.svg
        stdin: records of "<name>\\n<size>\\n<bytes>". Names must be
        omabar_[a-z0-9_]+, each file a plain SVG under 64 KiB with no scripts,
        entities or external references. Icons not in the set are removed;
        tiny-dfr's own icons are never touched.
"""
import os
import re
import subprocess
import sys
import tempfile

ETC = "/etc/tiny-dfr"
CONFIG = os.path.join(ETC, "config.toml")
MARKER = b"# Generated by omabar\n"
MAX_CONFIG = 65536
MAX_ICON = 65536
MAX_ICONS_TOTAL = 8 * 1024 * 1024
NAME = re.compile(rb"^omabar_[a-z0-9_]{1,64}$")
FORBIDDEN = re.compile(rb"<!ENTITY|<!DOCTYPE|<script|<foreignObject|href\s*=|url\s*\(|@import|on[a-z]+\s*=",
                       re.IGNORECASE)


def die(msg, code=1):
    sys.stderr.write(f"omabar-helper: {msg}\n")
    sys.exit(code)


def read_stdin(limit):
    data = sys.stdin.buffer.read(limit + 1)
    if len(data) > limit:
        die(f"input larger than {limit} bytes")
    return data


def write_atomic(path, data):
    fd, tmp = tempfile.mkstemp(dir=ETC, prefix=".omabar.")
    try:
        os.write(fd, data)
        os.fchmod(fd, 0o644)
        os.close(fd)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def cmd_config(live):
    data = read_stdin(MAX_CONFIG)
    if not data.startswith(MARKER):
        die("not a config generated by Omabar")
    try:
        data.decode("utf-8")
    except UnicodeDecodeError:
        die("config is not UTF-8")
    os.makedirs(ETC, exist_ok=True)
    if live and os.path.isfile(CONFIG) and not os.path.islink(CONFIG):
        # Same inode, so tiny-dfr's one-shot watch on the file sees the close.
        fd = os.open(CONFIG, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
        try:
            os.write(fd, data)
        finally:
            os.close(fd)
        return
    write_atomic(CONFIG, data)
    subprocess.run(["/usr/bin/systemctl", "restart", "tiny-dfr.service"], check=False)


def cmd_icons():
    data = read_stdin(MAX_ICONS_TOTAL)
    icons, pos = {}, 0
    while pos < len(data):
        nl = data.find(b"\n", pos)
        nl2 = data.find(b"\n", nl + 1)
        if nl < 0 or nl2 < 0:
            die("malformed icon stream")
        name, size = data[pos:nl], data[nl + 1:nl2]
        if not NAME.match(name) or not size.isdigit() or int(size) > MAX_ICON:
            die("bad icon name or size")
        body = data[nl2 + 1:nl2 + 1 + int(size)]
        if len(body) != int(size):
            die("truncated icon stream")
        head = body.lstrip()
        if not (head.startswith(b"<svg") or head.startswith(b"<?xml")) or FORBIDDEN.search(body):
            die(f"{name.decode()}: not a plain SVG")
        icons[name.decode()] = body
        pos = nl2 + 1 + int(size)
    os.makedirs(ETC, exist_ok=True)
    for name, body in icons.items():
        write_atomic(os.path.join(ETC, name + ".svg"), body)
    for f in os.listdir(ETC):
        if f.startswith("omabar_") and f.endswith(".svg") and f[:-4] not in icons:
            os.unlink(os.path.join(ETC, f))


def main():
    args = sys.argv[1:]
    if os.geteuid() != 0:
        die("must run as root (through pkexec)")
    if args in (["config"], ["config", "--live"]):
        cmd_config(len(args) == 2)
    elif args == ["icons"]:
        cmd_icons()
    else:
        die("usage: omabar-helper config [--live] | icons", 2)


if __name__ == "__main__":
    main()
