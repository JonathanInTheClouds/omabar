#!/usr/bin/env python3
"""Omabar: Touch Bar layouts for Omarchy on Intel T2 MacBook Pros.

  omabar list                    JSON for the panel: layouts (expanded for preview), settings, health
  omabar apply <id>              make <id> the live layout and remember it as your pick
  omabar auto [<app-id>]         follow mode: apply the layout for the focused app
  omabar refresh-weather         update cached weather; re-apply the live layout if it shows weather
  omabar retheme                 regenerate icons from the current Omarchy theme and reload the bar
  omabar colors default|theme    Omabar's own colours, or match the current Omarchy theme
  omabar follow on|off           turn following the focused app on or off
  omabar empty-default on|off    on an empty desktop, return to your pick (on) or keep the layout (off)
  omabar render <id>             print the tiny-dfr config a layout would produce (no changes)
  omabar editor-data             JSON for the editor: raw layouts, icons, keys, shortcuts, apps, rules
  omabar save <id>               save the layout JSON on stdin as one of your layouts
  omabar delete <id>             delete one of your layouts (a built-in with that id comes back)
  omabar try                     put the layout JSON on stdin on the bar until `omabar restore`
  omabar restore                 put the live layout back after a try
  omabar save-rules              save the rules JSON on stdin
  omabar doctor                  check the whole setup and print what is wrong
  omabar migrate                 import settings from jonathan.touchbar-layouts and remove its bind block

Layouts are JSON files: built-in ones ship in the plugin's layouts/ folder, your
own live in ~/.config/omarchy/omabar/layouts/ (same id overrides a built-in).
See AGENTS.md for the format and how everything fits together.
"""
import fcntl
import functools
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import time
import tomllib

PLUGIN = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
BUILTIN_LAYOUTS = os.path.join(PLUGIN, "layouts")
ICON_SOURCES = os.path.join(PLUGIN, "icons")

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config/omarchy/omabar")
USER_LAYOUTS = os.path.join(CONF, "layouts")
USER_ICONS = os.path.join(CONF, "icons")
RULES = os.path.join(CONF, "rules.json")
CACHE = os.path.join(HOME, ".cache/omabar")
GEN_ICONS = os.path.join(CACHE, "icons")
WEATHER_CACHE = os.path.join(CACHE, "weather.json")
STATE = os.path.join(HOME, ".local/state/omabar")
LIVE = os.path.join(STATE, "live.json")
MANUAL = os.path.join(STATE, "manual-pick")
THEME_COLORS = os.path.join(HOME, ".local/state/omarchy/current/theme/colors.toml")
WEATHER_LOCATION = os.path.join(HOME, ".local/state/omarchy/settings/weather.json")
BINDINGS = os.path.join(HOME, ".config/hypr/bindings.lua")
BIND_BEGIN = "-- omabar begin"
BIND_END = "-- omabar end"
LEGACY_BIND_BEGIN = "-- io.github.austindixson.touchbar begin"
LEGACY_BIND_END = "-- io.github.austindixson.touchbar end"

# Tests point this at a path that doesn't exist, so nothing can reach the real system.
HELPER = os.environ.get("OMABAR_HELPER", "/usr/local/libexec/omabar-helper")
ETC = "/etc/tiny-dfr"
ETC_CONFIG = os.path.join(ETC, "config.toml")
STOCK_ICONS = "/usr/share/tiny-dfr"
MARKER = "# Generated by omabar"

MAX_LAYOUT_BYTES = 65536
MAX_BINDINGS_BYTES = 262144
META_KEYS = ("name", "description")
ROLES = ("accent", "foreground", "dim", "danger", "white")
ICON_NAME = re.compile(r"^[a-z0-9_]{1,48}$")
KEY_NAME = re.compile(r"^[A-Za-z0-9]{1,24}$")
HYPR_KEY = re.compile(r"^((SUPER|CTRL|ALT|SHIFT) \+ )*(code:\d{1,3}|XF86\w{1,32}|[A-Za-z0-9_]{1,32})$")


def fail(msg):
    print(msg, file=sys.stderr)
    sys.exit(1)


def atomic_write(path, data, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path), prefix="." + os.path.basename(path) + ".")
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data.encode("utf-8") if isinstance(data, str) else data)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        if os.path.exists(tmp):
            os.unlink(tmp)
        raise


def read_json(path, limit=MAX_LAYOUT_BYTES):
    if os.path.islink(path) or not os.path.isfile(path) or os.path.getsize(path) > limit:
        raise ValueError(f"not a regular file under {limit // 1024} KiB: {path}")
    with open(path, encoding="utf-8") as f:
        return json.load(f)


# ---------- layouts ----------
def layout_paths():
    """id -> (path, source). Your layouts override built-in ones with the same id."""
    out = {}
    for d, source in ((BUILTIN_LAYOUTS, "built-in"), (USER_LAYOUTS, "yours")):
        if os.path.isdir(d):
            for f in os.listdir(d):
                if f.endswith(".json") and re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,47}", f[:-5]):
                    out[f[:-5]] = (os.path.join(d, f), source)
    return dict(sorted(out.items()))


def layout_ids():
    return list(layout_paths())


def read_layout(lid):
    paths = layout_paths()
    if lid not in paths:
        raise ValueError(f"No layout named {lid!r}")
    L = read_json(paths[lid][0])
    if not isinstance(L, dict):
        raise ValueError(f"{paths[lid][0]}: expected a JSON object")
    return L


def body(L):
    return {k: v for k, v in L.items() if k not in META_KEYS}


def rows(L):
    return (L.get("buttons") or []) + (L.get("fnLayer") or [])


# ---------- theme ----------
def _rgb(h):
    h = str(h).strip().lstrip("#")
    if not re.fullmatch(r"[0-9a-fA-F]{6}", h):
        return None
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


def _hex(c):
    return "#%02X%02X%02X" % tuple(max(0, min(255, round(v))) for v in c)


def _lum(c):
    def ch(v):
        v /= 255
        return v / 12.92 if v <= 0.03928 else ((v + 0.055) / 1.055) ** 2.4
    r, g, b = (ch(v) for v in c)
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def _on_black(c, minimum):
    """Lighten towards white until the colour reads on the Touch Bar's black."""
    for i in range(11):
        mixed = tuple(v + (255 - v) * i / 10 for v in c)
        if (_lum(mixed) + 0.05) / 0.05 >= minimum:
            return mixed
    return (255, 255, 255)


# Omabar's own look: green launchers, pale-ice system keys (from Omarchy's
# Hackerman theme). Used unless the user turns on "match the Omarchy theme".
DEFAULT_PALETTE = {"accent": "#82FB9C", "foreground": "#DDF7FF", "dim": "#B5C5DB",
                   "danger": "#FF5F6D", "white": "#FFFFFF"}


def color_mode():
    return "theme" if load_rules().get("colors") == "theme" else "default"


@functools.lru_cache(maxsize=None)
def palette():
    """Role colours: Omabar's defaults, or the current Omarchy theme's when
    colors is "theme", each made readable on the Touch Bar's black. Light
    themes have dark foregrounds; those are swapped or lightened."""
    if color_mode() != "theme":
        return dict(DEFAULT_PALETTE)
    try:
        with open(THEME_COLORS, "rb") as f:
            t = tomllib.load(f)
    except (OSError, tomllib.TOMLDecodeError):
        t = {}
    get = lambda k: _rgb(t.get(k, "")) if t.get(k) else None
    fg = next((c for c in (get("foreground"), get("light_foreground"), get("dark_foreground"))
               if c and (_lum(c) + 0.05) / 0.05 >= 6), None)
    fg = fg or _on_black(get("foreground") or (221, 221, 221), 6)
    dim = get("light_foreground")
    if not dim or dim == fg or (_lum(dim) + 0.05) / 0.05 < 4.5 or _lum(dim) >= _lum(fg):
        dim = _on_black(tuple(v * 0.78 for v in fg), 4.5)
    accent = _on_black(get("accent") or (130, 251, 156), 4.5)
    red = get("red")
    if red and red[0] > red[1] * 1.2 and red[0] > red[2] * 1.1:
        danger = _on_black(red, 4.5)
    else:
        danger = (255, 95, 109)  # the theme's "red" isn't red (Hackerman's is green)
    return {"accent": _hex(accent), "foreground": _hex(fg), "dim": _hex(dim),
            "danger": _hex(danger), "white": "#FFFFFF"}


# ---------- icons ----------
def icon_source(icon):
    """Uncoloured source SVG: yours (~/.config/omarchy/omabar/icons) first, then the plugin's."""
    for d in (USER_ICONS, ICON_SOURCES):
        p = os.path.join(d, str(icon) + ".svg")
        if os.path.isfile(p):
            return p
    return None


def icon_file(icon, tint):
    return f"omabar_{tint}_{icon}"


def tinted_svg(icon, tint):
    with open(icon_source(icon), encoding="utf-8") as f:
        svg = f.read()
    colour = palette()[tint]
    # Paths, not the root <svg>: Qt (the panel preview) ignores a root fill.
    return re.sub(r"<path(?![^>]*\bfill=)", f'<path fill="{colour}"', svg)


def wanted_icons(extra=()):
    """Every tinted icon any layout can show, including all weather states.
    `extra` adds unsaved layouts (a draft being tried on the bar)."""
    want = set()
    layouts = []
    for lid in layout_ids():
        try:
            layouts.append(read_layout(lid))
        except (OSError, ValueError):
            continue
    for L in list(layouts) + list(extra):
        for b in rows(L):
            if isinstance(b, dict) and b.get("icon") and b.get("tint", "white") in ROLES:
                if icon_source(b["icon"]):
                    want.add((b["icon"], b.get("tint", "white")))
            if isinstance(b, dict) and b.get("weather") == "icon":
                want.update((w, "foreground") for w in WEATHER_ICONS)
    return want


def generate_icons(extra=()):
    """Write tinted icons for the current theme into the cache. Returns {name: svg}."""
    out = {}
    for icon, tint in sorted(wanted_icons(extra)):
        out[icon_file(icon, tint)] = tinted_svg(icon, tint)
    os.makedirs(GEN_ICONS, exist_ok=True)
    for name, svg in out.items():
        p = os.path.join(GEN_ICONS, name + ".svg")
        try:
            with open(p, encoding="utf-8") as f:
                if f.read() == svg:
                    continue
        except OSError:
            pass
        atomic_write(p, svg)
    for f in os.listdir(GEN_ICONS):
        if f.endswith(".svg") and f[:-4] not in out:
            os.unlink(os.path.join(GEN_ICONS, f))
    return out


def installed_icons_match(icons):
    for name, svg in icons.items():
        try:
            with open(os.path.join(ETC, name + ".svg"), encoding="utf-8") as f:
                if f.read() != svg:
                    return False
        except OSError:
            return False
    try:
        extra = {f[:-4] for f in os.listdir(ETC) if f.startswith("omabar_") and f.endswith(".svg")}
    except OSError:
        return False
    return extra <= set(icons)


def install_icons(icons):
    """Hand the icons to the root helper as name/size/bytes records."""
    blob = bytearray()
    for name, svg in sorted(icons.items()):
        data = svg.encode("utf-8")
        blob += f"{name}\n{len(data)}\n".encode() + data
    run_helper(["icons"], bytes(blob))


def sync_icons(extra=()):
    """Make /etc/tiny-dfr hold exactly the icons for the current theme. True if it changed."""
    icons = generate_icons(extra)
    if installed_icons_match(icons):
        return False
    install_icons(icons)
    return True


# ---------- weather ----------
# {"weather": "icon"} and {"weather": "temp"} are placeholders, swapped for a real
# icon and text button from the cached conditions; both open Omarchy's forecast.
WEATHER_TAP = {"key": "F16", "hyprKey": "code:194", "command": "omarchy-shell omarchy.weather toggle"}
WEATHER_ICONS = ("sunny", "clear_night", "partly_cloudy_day", "partly_cloudy_night",
                 "cloud", "foggy", "rainy", "weather_snowy", "thunderstorm")


def weather_icon(code, is_day):
    """Open-Meteo WMO weather code to one of WEATHER_ICONS."""
    if code == 0:
        return "sunny" if is_day else "clear_night"
    if code in (1, 2):
        return "partly_cloudy_day" if is_day else "partly_cloudy_night"
    if code in (45, 48):
        return "foggy"
    if 71 <= code <= 77 or code in (85, 86):
        return "weather_snowy"
    if code >= 95:
        return "thunderstorm"
    if 51 <= code <= 67 or 80 <= code <= 82:
        return "rainy"
    return "cloud"


def load_weather():
    try:
        with open(WEATHER_CACHE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def curl_json(url):
    r = subprocess.run(["curl", "-fsS", "--max-time", "8", url], capture_output=True, text=True)
    if r.returncode:
        raise RuntimeError(r.stderr.strip() or f"curl failed for {url}")
    return json.loads(r.stdout)


def fetch_weather():
    """Current conditions for Omarchy's configured location, else the IP's."""
    old = load_weather() or {}
    try:
        with open(WEATHER_LOCATION, encoding="utf-8") as f:
            loc = json.load(f)
        lat, lon, auto = float(loc["latitude"]), float(loc["longitude"]), False
    except (OSError, ValueError, KeyError, TypeError):
        auto = True
        if old.get("auto") and old.get("lat") is not None:
            lat, lon = old["lat"], old["lon"]  # IP lookups are slow; reuse the last one
        else:
            area = curl_json("https://wttr.in/?format=j1")["nearest_area"][0]
            lat, lon = float(area["latitude"]), float(area["longitude"])
    cur = curl_json("https://api.open-meteo.com/v1/forecast"
                    f"?latitude={lat}&longitude={lon}"
                    "&current=temperature_2m,weather_code,is_day&timezone=auto")["current"]
    wx = {"lat": lat, "lon": lon, "auto": auto, "tempC": float(cur["temperature_2m"]),
          "code": int(cur["weather_code"]), "isDay": bool(cur["is_day"])}
    atomic_write(WEATHER_CACHE, json.dumps(wx), 0o600)
    return wx


def uses_weather(L):
    return any(isinstance(b, dict) and b.get("weather") for b in rows(L))


def imperial(L):
    unit = str(L.get("weatherUnit", "")).upper()
    if unit in ("F", "C"):
        return unit == "F"
    return os.environ.get("LANG", "").startswith(("en_US", "en_LR", "my_MM"))


def expand(L, wx):
    """The layout with weather placeholders replaced by real buttons."""
    if not uses_weather(L):
        return L

    def swap(b):
        kind = b.get("weather") if isinstance(b, dict) else None
        if not kind:
            return b
        out = dict(WEATHER_TAP)
        if b.get("stretch"):
            out["stretch"] = b["stretch"]
        if kind == "icon":
            out["icon"] = weather_icon(wx["code"], wx["isDay"]) if wx else "cloud"
            out["tint"] = "foreground"
        elif wx:
            t = wx["tempC"] * 9 / 5 + 32 if imperial(L) else wx["tempC"]
            out["text"] = f"{round(t)}°"
        else:
            out["text"] = "--°"
        return out

    L = dict(L)
    for k in ("buttons", "fnLayer"):
        if L.get(k):
            L[k] = [swap(b) for b in L[k]]
    return L


# ---------- rendering (layout -> tiny-dfr TOML) ----------
def toml_str(s):
    return json.dumps(str(s), ensure_ascii=False)


def validate(L):
    """Problems that would crash tiny-dfr or break binds, as a list of strings."""
    errs = []
    for row in ("buttons", "fnLayer"):
        items = L.get(row) or []
        if not isinstance(items, list):
            errs.append(f"{row} must be a list")
            continue
        if len(items) > 24:
            errs.append(f"{row} has {len(items)} buttons; tiny-dfr breaks above about 24")
        if row == "buttons" and not items:
            errs.append("the main row needs at least one button")
        for i, b in enumerate(items, 1):
            where = f"{row}[{i}]"
            if not isinstance(b, dict):
                errs.append(f"{where} must be an object")
                continue
            if b.get("spacer") or b.get("time") or b.get("battery") or b.get("weather"):
                continue
            key = b.get("key")
            keys = key if isinstance(key, list) else [key]
            if not key or not all(isinstance(k, str) and KEY_NAME.match(k) for k in keys):
                errs.append(f"{where} needs a key name (or a list of them)")
            if b.get("icon"):
                if not ICON_NAME.match(str(b["icon"])):
                    errs.append(f"{where} icon {b['icon']!r} isn't a plain icon name")
                elif b.get("tint", "white") not in ROLES:
                    errs.append(f"{where} tint must be one of {', '.join(ROLES)}")
                elif not icon_source(b["icon"]) and not os.path.isfile(os.path.join(STOCK_ICONS, b["icon"] + ".svg")):
                    errs.append(f"{where} icon {b['icon']!r} not found in ~/.config/omarchy/omabar/icons or the plugin's icons/")
            if bool(b.get("hyprKey")) != bool(b.get("command")):
                errs.append(f"{where} needs both hyprKey and command, or neither")
            elif b.get("hyprKey"):
                if not HYPR_KEY.match(str(b["hyprKey"])):
                    errs.append(f"{where} hyprKey {b['hyprKey']!r} isn't a Hyprland key spec")
                if "\n" in str(b["command"]):
                    errs.append(f"{where} command must be one line")
    return errs


def render_button(b):
    stretch = f", Stretch = {max(1, int(b.get('stretch', 1)))}" if b.get("stretch") else ""
    if b.get("spacer"):
        return f"    {{ Stretch = {max(1, int(b.get('stretch', 1)))} }}"
    if b.get("time"):
        loc = f", Locale = {toml_str(b['locale'])}" if b.get("locale") else ""
        return f"    {{ Time = {toml_str(b['time'])}{loc}, Action = \"Time\"{stretch} }}"
    if b.get("battery"):
        return f"    {{ Battery = {toml_str(b['battery'])}, Action = \"Battery\"{stretch} }}"
    key = b["key"]
    action = "[" + ", ".join(toml_str(k) for k in key) + "]" if isinstance(key, list) else toml_str(key)
    if b.get("icon"):
        name = icon_file(b["icon"], b.get("tint", "white")) if icon_source(b["icon"]) else b["icon"]
        label = f"Icon = {toml_str(name)}"
    else:
        label = f"Text = {toml_str(b.get('text', ''))}"
    return f"    {{ {label}, Action = {action}{stretch} }}"


def render(L):
    def flag(k, default):
        return "true" if L.get(k, default) else "false"

    def layer(name, items):
        return f"{name} = [\n" + ",\n".join(render_button(b) for b in items) + "\n]\n"

    # tiny-dfr panics on a layer with no buttons ("layer has 0 buttons"), which
    # leaves the bar on its crash screen. An empty Fn row gets plain F-keys.
    fn = L.get("fnLayer") or [{"text": f"F{i}", "key": f"F{i}"} for i in range(1, 13)]
    return (f"{MARKER}\n"
            f"MediaLayerDefault = {flag('mediaLayerDefault', True)}\n"
            f"ShowButtonOutlines = {flag('showButtonOutlines', True)}\n"
            "EnablePixelShift = false\n"
            f"FontTemplate = {toml_str(L.get('fontTemplate', ':bold'))}\n"
            f"AdaptiveBrightness = {flag('adaptiveBrightness', True)}\n"
            "ActiveBrightness = 128\n\n"
            + layer("PrimaryLayerKeys", fn)
            + "\n" + layer("MediaLayerKeys", L.get("buttons") or []))


# ---------- Hyprland binds ----------
# Every command has its own key, so bindings.lua carries the binds of every
# layout at once. Switching layouts never touches the Hyprland config; the
# block is rewritten only when the set of binds itself changes.
def bind_label(b, lid):
    """A readable, stable name for Omarchy's keybinding list, taken from the
    command (not the icon) so restyling a button never rewrites the binds."""
    cmd = str(b.get("command") or "").strip()
    m = re.fullmatch(r"uwsm-app -- ([A-Za-z0-9._+-]+)\.desktop", cmd)
    if m:
        return m.group(1)
    for prefix in ("omarchy-shell omarchy.", "omarchy-launch-", "omarchy-", "omarchy "):
        if cmd.startswith(prefix):
            return cmd[len(prefix):].replace("-", " ")
    return cmd[:40] or lid


def lua_str(s):
    return '"' + str(s).replace("\\", "\\\\").replace('"', '\\"') + '"'


def all_binds():
    seen = {}
    for lid in layout_ids():
        try:
            L = expand(read_layout(lid), None)
        except (OSError, ValueError):
            continue
        if validate(L):
            continue
        for b in rows(L):
            if isinstance(b, dict) and b.get("hyprKey") and b.get("command") and b["hyprKey"] not in seen:
                seen[b["hyprKey"]] = (bind_label(b, lid), b["command"])
    lines = [f"o.bind({lua_str(k)}, {lua_str('Touch Bar: ' + label)}, {lua_str(cmd)})"
             for k, (label, cmd) in sorted(seen.items())]
    shortcut = panel_shortcut()
    if shortcut and not shortcut_taken(shortcut):
        lines.append(f"o.bind({lua_str(shortcut)}, {lua_str('Omabar: Touch Bar layouts')}, "
                     f"{lua_str('omarchy-shell io.github.jonathanintheclouds.omabar toggle')})")
    return lines


# ---------- Omabar's own shortcut ----------
DEFAULT_SHORTCUT = "SUPER + ALT + T"
MODMASK = {"SHIFT": 1, "CTRL": 4, "ALT": 8, "SUPER": 64}


def panel_shortcut():
    s = load_rules().get("shortcut", DEFAULT_SHORTCUT)
    return s if isinstance(s, str) and HYPR_KEY.match(s) else ""


@functools.lru_cache(maxsize=None)
def hypr_binds():
    try:
        r = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True, timeout=3)
        binds = json.loads(r.stdout or "[]")
        return binds if isinstance(binds, list) else []
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def shortcut_taken(combo):
    """True if a bind that isn't Omabar's already uses this key combination."""
    parts = [p.strip() for p in combo.split("+")]
    mask = sum(MODMASK.get(p.upper(), 0) for p in parts[:-1])
    key = parts[-1].upper()
    for b in hypr_binds():
        desc = str(b.get("description") or "")
        if desc.startswith(("Omabar:", "Touch Bar")):
            continue
        if b.get("modmask") == mask and str(b.get("key", "")).upper() == key:
            return True
    return False


def read_bindings():
    """bindings.lua through a bounded, no-follow, non-blocking open (regular files only)."""
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        fd = os.open(BINDINGS, flags)
    except FileNotFoundError:
        return None, None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_size > MAX_BINDINGS_BYTES:
            fail(f"Refusing to edit {BINDINGS}: not a regular file under 256 KiB")
        data = os.read(fd, MAX_BINDINGS_BYTES + 1)
    finally:
        os.close(fd)
    return data.decode("utf-8"), st


def strip_block(text, begin, end):
    if begin in text and end in text:
        pre, rest = text.split(begin, 1)
        post = rest.split(end, 1)[1]
        return pre.rstrip() + "\n" + post.lstrip("\n")
    return text


def sync_binds():
    """Write the union of binds into bindings.lua, only when it differs."""
    want = all_binds()
    text, st = read_bindings()
    if text is None:
        return  # no user bindings file: nothing to do
    if BIND_BEGIN in text and BIND_END in text:
        block = text.split(BIND_BEGIN, 1)[1].split(BIND_END, 1)[0]
        if [l for l in block.splitlines() if l.startswith("o.bind(")] == want:
            return
    new = strip_block(text, BIND_BEGIN, BIND_END).rstrip() + "\n\n" + "\n".join(
        [BIND_BEGIN, "-- Managed by Omabar: Touch Bar buttons that run commands.", *want, BIND_END]) + "\n"
    cur = os.lstat(BINDINGS)
    if (cur.st_dev, cur.st_ino) != (st.st_dev, st.st_ino):
        fail(f"{BINDINGS} changed while updating, refusing")
    atomic_write(BINDINGS, new, stat.S_IMODE(st.st_mode))


# ---------- root helper ----------
def helper_ok():
    return os.path.isfile(HELPER) and os.access(HELPER, os.X_OK)


def tiny_dfr_crashed():
    """True if the running tiny-dfr has panicked. After a panic it stays alive
    on a "tiny-dfr crashed" screen and no longer reloads its config."""
    try:
        pid = subprocess.run(["systemctl", "show", "tiny-dfr.service", "-p", "MainPID", "--value"],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if not pid.isdigit() or pid == "0":
            return False
        r = subprocess.run(["journalctl", f"_PID={pid}", "-o", "cat", "--no-pager"],
                           capture_output=True, text=True, timeout=5)
        return "panicked at" in r.stdout
    except (OSError, subprocess.SubprocessError):
        return False


def push_config(text):
    """Hand a config to tiny-dfr in place, or restart it with the config if it
    has crashed (before or because of this write)."""
    data = text.encode("utf-8")
    if tiny_dfr_crashed():
        run_helper(["config"], data)  # replaces the file and restarts tiny-dfr
        return
    run_helper(["config", "--live"], data)
    time.sleep(0.4)
    if tiny_dfr_crashed():
        run_helper(["config"], data)


def run_helper(args, data):
    if not helper_ok():
        fail("The Omabar helper isn't installed. Run the plugin's system/install.sh once "
             "(or press Set up in the panel).")
    r = subprocess.run(["/usr/bin/pkexec", HELPER, *args], input=data, capture_output=True)
    if r.returncode:
        fail(r.stderr.decode(errors="replace").strip() or f"omabar-helper {' '.join(args)} failed")


# ---------- follow the focused app ----------
DEFAULT_RULES = {
    "colors": "default",
    "follow": False,
    "emptyDefault": True,
    "default": "duotone-weather",
    "rules": [
        {"app": "Alacritty|kitty|com.mitchellh.ghostty|foot|org.omarchy.agent", "layout": "dev"},
        {"app": "code|code-oss|com.microsoft.VSCode|dev.zed.Zed", "layout": "dev"},
        {"app": "chromium|google-chrome|firefox|brave-browser|zen", "layout": "browser"},
        {"app": "spotify", "layout": "studio"},
        {"app": "zoom|discord|Slack|signal", "layout": "meeting"},
        {"app": "libreoffice-impress", "layout": "presenter"},
        {"app": "libreoffice-calc", "layout": "numpad"},
    ],
}


def load_rules():
    try:
        r = read_json(RULES)
        return r if isinstance(r, dict) else dict(DEFAULT_RULES)
    except FileNotFoundError:
        return dict(DEFAULT_RULES)
    except (OSError, ValueError):
        if not os.path.exists(RULES):
            return dict(DEFAULT_RULES)
        return {"follow": False, "rules": [], "error": f"Could not read {RULES}"}


def save_rules(r):
    atomic_write(RULES, json.dumps(r, indent=2) + "\n")


def rule_warnings(rules):
    ids, out = set(layout_ids()), []
    if rules.get("default") and rules["default"] not in ids:
        out.append(f"default layout {rules['default']!r} doesn't exist")
    for i, rule in enumerate(rules.get("rules") or [], 1):
        try:
            re.compile(str(rule.get("app", "")))
        except re.error as e:
            out.append(f"rule {i}: bad app pattern ({e})")
        if rule.get("layout") not in ids:
            out.append(f"rule {i}: layout {rule.get('layout')!r} doesn't exist")
    return out


def layout_for_app(rules, app):
    for rule in rules.get("rules") or []:
        try:
            if app and re.fullmatch(str(rule.get("app", "")), app, re.IGNORECASE):
                return rule.get("layout")
        except re.error:
            continue
    return None


def manual_pick():
    try:
        with open(MANUAL, encoding="utf-8") as f:
            lid = f.read().strip()
        return lid if lid in layout_ids() else None
    except OSError:
        return None


def focused_window():
    """(class, title) from Hyprland itself, None for no window, "unknown" on error.
    Closing a popup that held the keyboard reports "no window" in the event
    stream and never re-announces the app, so the event alone isn't enough."""
    try:
        r = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True, timeout=3)
        w = json.loads(r.stdout or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return "unknown"
    if not isinstance(w, dict) or not w.get("address"):
        return None
    return (w.get("class") or w.get("initialClass") or "", w.get("title") or "")


# ---------- hardware ----------
def touchbar_width():
    """Logical width of the Touch Bar panel from its DRM connector, else None."""
    base = "/sys/class/drm"
    try:
        for card in os.listdir(base):
            if not re.fullmatch(r"card\d+", card):
                continue
            drv = os.path.realpath(os.path.join(base, card, "device/driver"))
            if os.path.basename(drv) != "appletbdrm":
                continue
            for conn in os.listdir(os.path.join(base, card)):
                if conn.startswith(card + "-"):
                    with open(os.path.join(base, card, conn, "modes")) as f:
                        m = re.match(r"(\d+)x(\d+)", f.read())
                    if m:
                        return max(int(m.group(1)), int(m.group(2)))
    except OSError:
        pass
    return None


def hardware():
    try:
        with open("/sys/class/dmi/id/product_name") as f:
            model = f.read().strip()
    except OSError:
        model = ""
    width = touchbar_width()
    supported = bool(re.match(r"MacBookPro1[56],", model))
    return {"model": model, "supported": supported, "width": width or (2008 if model.startswith(
        ("MacBookPro16,1", "MacBookPro16,4", "MacBookPro15,1", "MacBookPro15,3")) else 2170),
        "displayFound": width is not None}


# ---------- Omarchy theme hook ----------
THEME_HOOK = os.path.join(HOME, ".config/omarchy/hooks/theme-set.d/omabar")


def ensure_theme_hook():
    """Recolour the Touch Bar after `omarchy theme set` (only matters in theme mode)."""
    script = ("#!/bin/bash\n"
              "# Installed by Omabar: recolour the Touch Bar for the new theme.\n"
              f"{json.dumps(os.path.join(PLUGIN, 'bin/omabar'))} retheme >/dev/null 2>&1 &\n")
    try:
        with open(THEME_HOOK, encoding="utf-8") as f:
            if f.read() == script:
                return
    except OSError:
        pass
    atomic_write(THEME_HOOK, script, 0o755)


# ---------- locking ----------
def take_lock():
    """Focus changes, the weather refresh and manual picks run as separate
    processes; make them take turns so their writes never interleave."""
    os.makedirs(CACHE, exist_ok=True)
    fd = os.open(os.path.join(CACHE, "lock"), os.O_RDWR | os.O_CREAT, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


# ---------- commands ----------
def resolve_for_preview(b):
    stretch = max(1, int(b.get("stretch", 1) or 1))
    if b.get("spacer"):
        return {"kind": "spacer", "stretch": stretch}
    if b.get("time"):
        return {"kind": "time", "format": str(b["time"]), "stretch": stretch}
    if b.get("battery"):
        return {"kind": "battery", "mode": str(b["battery"]), "stretch": stretch}
    if b.get("icon"):
        icon, tint = str(b["icon"]), b.get("tint", "white")
        path = os.path.join(GEN_ICONS, icon_file(icon, tint) + ".svg")
        if not os.path.isfile(path):
            path = os.path.join(STOCK_ICONS, icon + ".svg") if os.path.isfile(
                os.path.join(STOCK_ICONS, icon + ".svg")) else ""
        return {"kind": "icon", "name": icon, "path": path, "stretch": stretch}
    return {"kind": "text", "text": str(b.get("text", "")), "stretch": stretch}


@functools.lru_cache(maxsize=None)
def font_family(template):
    try:
        return subprocess.run(["fc-match", "-f", "%{family[0]}", template or ":bold"],
                              capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


def read_live():
    try:
        return body(read_json(LIVE))
    except (OSError, ValueError):
        return None


def cmd_list():
    ensure_theme_hook()
    live, wx, rules = read_live(), load_weather(), load_rules()
    generate_icons()
    out = []
    for lid, (path, source) in layout_paths().items():
        try:
            raw = read_layout(lid)
        except (OSError, ValueError) as e:
            out.append({"id": lid, "name": lid, "source": source, "error": str(e)})
            continue
        L = expand(raw, wx)
        errs = validate(L)
        out.append({
            "id": lid, "source": source, "path": path,
            "name": L.get("name") or lid,
            "description": L.get("description", ""),
            "error": "; ".join(errs[:3]) if errs else "",
            "active": live is not None and body(L) == live,
            "outlines": bool(L.get("showButtonOutlines", True)),
            "font": font_family(L.get("fontTemplate", ":bold")),
            "main": [resolve_for_preview(b) for b in L.get("buttons") or [] if isinstance(b, dict)],
            "fn": [resolve_for_preview(b) for b in L.get("fnLayer") or [] if isinstance(b, dict)],
            "weather": uses_weather(raw),
        })
    print(json.dumps({
        "layoutsDir": USER_LAYOUTS,
        "rulesFile": RULES,
        "passwordless": helper_ok(),
        "follow": bool(rules.get("follow")),
        "emptyDefault": rules.get("emptyDefault", True) is not False,
        "manualPick": manual_pick() or "",
        "defaultLayout": rules.get("default", ""),
        "rulesError": rules.get("error", ""),
        "ruleWarnings": rule_warnings(rules),
        "hardware": hardware(),
        "palette": palette(),
        "colors": color_mode(),
        "installScript": os.path.join(PLUGIN, "system/install.sh"),
        "helperPath": HELPER,
        "layouts": out,
    }))


def cmd_apply(lid, wx=None):
    if lid not in layout_ids():
        fail(f"No layout named {lid!r}")
    raw = read_layout(lid)
    if wx is None and uses_weather(raw):
        wx = load_weather()
        if wx is None:
            try:
                wx = fetch_weather()
            except (RuntimeError, ValueError, KeyError, OSError):
                wx = None  # "--°" for now; the next refresh fills it in
    L = expand(raw, wx)
    errs = validate(L)
    if errs:
        fail(f"Layout {lid!r} has problems: " + "; ".join(errs))
    sync_icons()
    sync_binds()
    push_config(render(L))
    # live.json is what "active" is judged by, so it only changes once the bar
    # really has the new layout; a failed switch is retried next time.
    atomic_write(LIVE, json.dumps(L, indent=2, ensure_ascii=False) + "\n")


TRIAL = os.path.join(CACHE, "trial-until")


def trial_active():
    """A draft from the editor is on the bar; don't swap it out underneath."""
    try:
        with open(TRIAL) as f:
            return float(f.read().strip()) > time.time()
    except (OSError, ValueError):
        return False


def cmd_auto(app):
    rules = load_rules()
    if trial_active() or not rules.get("follow") or not helper_ok():
        return  # without the passwordless helper every switch would ask for a password
    win = focused_window()
    if win != "unknown":
        app = None if win is None else (win[0] or "?")
    if not app:
        if rules.get("emptyDefault", True) is False:
            return
        lid = None
    else:
        lid = layout_for_app(rules, app)
    lid = lid or manual_pick() or rules.get("default")
    if not lid or lid not in layout_ids():
        return
    live = read_live()
    if live is not None and body(expand(read_layout(lid), load_weather())) == live:
        return
    cmd_apply(lid)


def cmd_refresh_weather():
    if trial_active():
        return
    old, live = load_weather(), read_live()
    active = None
    for lid in layout_ids():
        try:
            raw = read_layout(lid)
        except (OSError, ValueError):
            continue
        if uses_weather(raw) and live is not None and body(expand(raw, old)) == live:
            active = lid
            break
    try:
        wx = fetch_weather()
    except (RuntimeError, ValueError, KeyError, OSError) as e:
        fail(f"Weather update failed: {e}")
    if active and helper_ok() and body(expand(read_layout(active), wx)) != live:
        cmd_apply(active, wx)


def cmd_retheme():
    """Recolour the icons for the current colour mode and reload the bar.
    Run by the Omarchy theme-set hook and when the colour mode changes."""
    palette.cache_clear()
    if not helper_ok():
        generate_icons()
        return
    if sync_icons():
        live = read_live()
        if live is not None:
            # tiny-dfr only reloads icons along with its config; rewrite it as-is.
            push_config(render(live))


def cmd_colors(mode):
    rules = load_rules()
    if rules.get("error"):
        fail(rules["error"])
    rules["colors"] = mode
    save_rules(rules)
    cmd_retheme()


def cmd_set_flag(flag, state):
    rules = load_rules()
    if rules.get("error"):
        fail(rules["error"])
    rules[flag] = state == "on"
    save_rules(rules)


def cmd_doctor():
    checks = []

    def check(ok, what, fix=""):
        checks.append((ok, what, fix))

    hw = hardware()
    check(hw["supported"], f"Intel T2 MacBook Pro with a Touch Bar ({hw['model'] or 'unknown model'})",
          "Omabar supports MacBookPro15,x and 16,x.")
    check(shutil.which("tiny-dfr") is not None, "tiny-dfr installed", "sudo pacman -S tiny-dfr")
    en = subprocess.run(["systemctl", "is-enabled", "tiny-dfr"], capture_output=True, text=True).stdout.strip()
    check(en == "enabled", "tiny-dfr enabled", "run system/install.sh")
    act = subprocess.run(["systemctl", "is-active", "tiny-dfr"], capture_output=True, text=True).stdout.strip()
    check(act == "active", f"tiny-dfr running ({act})", "sudo systemctl restart tiny-dfr")
    check(not tiny_dfr_crashed(), "tiny-dfr isn't stuck on its crash screen", "activate any layout (Omabar restarts it)")
    check(hw["displayFound"], "Touch Bar display driver (appletbdrm) bound", "reboot once after install.sh")
    check(helper_ok(), "Omabar helper installed (passwordless switching)", "run system/install.sh")
    res = subprocess.run(["systemctl", "is-enabled", "omabar-resume.service"], capture_output=True, text=True).stdout.strip()
    check(res == "enabled", "resume fix enabled", "run system/install.sh")
    try:
        with open(ETC_CONFIG, encoding="utf-8") as f:
            first = f.readline().strip()
    except OSError:
        first = ""
    check(first == MARKER, "tiny-dfr config generated by Omabar", "activate any layout")
    check(installed_icons_match(generate_icons()), "icons installed for the current theme", "omabar retheme")
    text, _ = read_bindings()
    check(text is not None and BIND_BEGIN in text, "Hyprland binds present in bindings.lua", "activate any layout")
    check(text is None or LEGACY_BIND_BEGIN not in text, "no leftover austindixson bind block", "omabar migrate")
    rules = load_rules()
    for w in rule_warnings(rules) + ([rules["error"]] if rules.get("error") else []):
        check(False, f"rules: {w}", f"edit {RULES}")
    for lid in layout_ids():
        try:
            errs = validate(expand(read_layout(lid), None))
        except (OSError, ValueError) as e:
            errs = [str(e)]
        for e in errs:
            check(False, f"layout {lid}: {e}")
    bad = 0
    for ok, what, fix in checks:
        print(("ok    " if ok else "FIX   ") + what + ("" if ok or not fix else f"  ->  {fix}"))
        bad += not ok
    sys.exit(1 if bad else 0)


def cmd_migrate():
    """Bring settings over from jonathan.touchbar-layouts (the prototype)."""
    old_rules = os.path.join(HOME, ".config/omarchy/touchbar-rules.json")
    rename = {"hackerman": "duotone", "hackerman-weather": "duotone-weather"}
    if os.path.isfile(old_rules) and not os.path.exists(RULES):
        r = read_json(old_rules)
        r["default"] = rename.get(r.get("default"), r.get("default"))
        r.setdefault("colors", "default")
        for rule in r.get("rules") or []:
            rule["layout"] = rename.get(rule.get("layout"), rule.get("layout"))
        save_rules(r)
        print(f"rules imported into {RULES}")
    old_pick = os.path.join(HOME, ".cache/touchbar-layouts/manual-pick")
    if os.path.isfile(old_pick) and not os.path.exists(MANUAL):
        with open(old_pick) as f:
            lid = f.read().strip()
        atomic_write(MANUAL, rename.get(lid, lid) + "\n")
        print("manual pick imported")
    text, st = read_bindings()
    if text is not None and LEGACY_BIND_BEGIN in text:
        atomic_write(BINDINGS, strip_block(text, LEGACY_BIND_BEGIN, LEGACY_BIND_END), stat.S_IMODE(st.st_mode))
        print("removed the old austindixson bind block from bindings.lua")


# ---------- editor support ----------
# Spare keys for buttons that run commands, in the order they are handed out.
# (tiny-dfr key, Hyprland key). Hyprland codes are evdev + 8.
SPARE_KEYS = (
    [(f"F{n}", f"code:{183 + n - 13 + 8}") for n in range(13, 25)]
    + [("Prog1", "code:156"), ("Prog2", "code:157"), ("Prog3", "code:210"), ("Prog4", "code:211")]
    + [(["LeftCtrl", "LeftAlt", "LeftShift", f"F{n}"], f"CTRL + ALT + SHIFT + code:{183 + n - 13 + 8}")
       for n in range(13, 25)]
)

# Hyprland key names -> tiny-dfr (input-linux) key names, for turning the
# user's Omarchy shortcuts into Touch Bar key combos.
HYPR_TO_KEY = {**{c: c for c in "ABCDEFGHIJKLMNOPQRSTUVWXYZ"},
               **{str(d): f"Num{d}" for d in range(10)},
               **{f"F{n}": f"F{n}" for n in range(1, 13)},
               "SPACE": "Space", "RETURN": "Enter", "TAB": "Tab", "ESCAPE": "Esc",
               "BACKSPACE": "Backspace", "DELETE": "Delete", "INSERT": "Insert",
               "COMMA": "Comma", "PERIOD": "Dot", "SLASH": "Slash", "MINUS": "Minus",
               "EQUAL": "Equal", "GRAVE": "Grave", "SEMICOLON": "Semicolon",
               "APOSTROPHE": "Apostrophe", "BRACKETLEFT": "LeftBrace", "BRACKETRIGHT": "RightBrace",
               "BACKSLASH": "Backslash", "LEFT": "Left", "RIGHT": "Right", "UP": "Up", "DOWN": "Down",
               "HOME": "Home", "END": "End", "PRINT": "Sysrq"}
MOD_KEYS = [(64, "LeftMeta", "SUPER"), (4, "LeftCtrl", "CTRL"), (8, "LeftAlt", "ALT"), (1, "LeftShift", "SHIFT")]

KEY_PRESETS = (
    [{"label": l, "key": k, "group": "Media"} for l, k in (
        ("Play / pause", "PlayPause"), ("Previous track", "PreviousSong"), ("Next track", "NextSong"),
        ("Mute", "Mute"), ("Volume down", "VolumeDown"), ("Volume up", "VolumeUp"), ("Mic mute", "MicMute"))]
    + [{"label": l, "key": k, "group": "System"} for l, k in (
        ("Brightness down", "BrightnessDown"), ("Brightness up", "BrightnessUp"),
        ("Omarchy menu (Search key)", "Search"), ("Escape", "Esc"))]
    + [{"label": f"Workspace {n}", "key": ["LeftMeta", f"Num{n}"], "group": "Workspaces"} for n in range(1, 10)]
    + [{"label": f"F{n}", "key": f"F{n}", "group": "Function keys"} for n in range(1, 13)]
)


def omarchy_shortcuts():
    """The user's Hyprland binds that a Touch Bar button can send, with their descriptions."""
    out, seen = [], set()
    for b in hypr_binds():
        desc, key = str(b.get("description") or ""), str(b.get("key") or "")
        if not desc or not key or desc.startswith(("Touch Bar", "Omabar:")):
            continue
        name = HYPR_TO_KEY.get(key.upper())
        mask = b.get("modmask", 0)
        if not name or not isinstance(mask, int) or mask & ~(64 | 4 | 8 | 1):
            continue
        mods = [k for bit, k, _ in MOD_KEYS if mask & bit]
        combo = " + ".join([h for bit, _, h in MOD_KEYS if mask & bit] + [key.upper()])
        if combo in seen:
            continue
        seen.add(combo)
        out.append({"label": desc, "combo": combo, "key": mods + [name] if mods else name})
    return sorted(out, key=lambda x: x["label"].lower())


def desktop_apps():
    """Installed apps (desktop entries) the app picker can launch."""
    found = {}
    dirs = [os.path.join(HOME, ".local/share/applications"), "/usr/share/applications"]
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for f in names:
            if not f.endswith(".desktop") or f in found:
                continue
            entry, section = {}, False
            try:
                with open(os.path.join(d, f), encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        line = line.strip()
                        if line.startswith("["):
                            section = line == "[Desktop Entry]"
                        elif section and "=" in line:
                            k, v = line.split("=", 1)
                            entry.setdefault(k, v)
            except OSError:
                continue
            found[f] = entry
    out = []
    for f, e in found.items():
        if e.get("Type", "Application") != "Application" or e.get("NoDisplay") == "true" or e.get("Hidden") == "true":
            continue
        if not e.get("Name") or not re.fullmatch(r"[A-Za-z0-9._+-]+\.desktop", f):
            continue
        out.append({"id": f, "name": e["Name"], "command": f"uwsm-app -- {f}"})
    return sorted(out, key=lambda a: a["name"].lower())


def used_keys(skip=None):
    """hyprKey -> command for every saved layout except `skip`, plus fixed keys."""
    used = {"code:194": WEATHER_TAP["command"], "XF86Search": "omarchy-menu toggle"}
    for lid in layout_ids():
        if lid == skip:
            continue
        try:
            L = read_layout(lid)
        except (OSError, ValueError):
            continue
        for b in rows(L):
            if isinstance(b, dict) and b.get("hyprKey") and b.get("command"):
                used.setdefault(b["hyprKey"], b["command"])
    return used


def assign_keys(L, lid=None):
    """Give every button that has a command but no key a spare key. A command
    already bound somewhere keeps its key, so the same app or script never
    gets two binds."""
    used = used_keys(skip=lid)
    by_command = {cmd: k for k, cmd in used.items()}
    own = {}
    for b in rows(L):
        if isinstance(b, dict) and b.get("hyprKey") and b.get("command"):
            own.setdefault(b["hyprKey"], b["command"])
    for b in rows(L):
        if not isinstance(b, dict) or not b.get("command"):
            continue
        cmd = b["command"]
        if b.get("hyprKey") and used.get(b["hyprKey"], cmd) == cmd and own.get(b["hyprKey"]) == cmd:
            continue  # already has a key of its own
        if cmd in by_command:
            hk = by_command[cmd]
            key = next((k for k, h in SPARE_KEYS if h == hk), None)
            if key is None and hk == WEATHER_TAP["hyprKey"]:
                key = WEATHER_TAP["key"]
            if key is not None:
                b["key"], b["hyprKey"] = key, hk
                continue
        taken = set(used) | set(own)
        for key, hk in SPARE_KEYS:
            if hk not in taken:
                b["key"], b["hyprKey"] = key, hk
                own[hk] = cmd
                by_command[cmd] = hk
                break
        else:
            fail("No spare keys left for another command button.")
    return L


def read_stdin_json(limit=MAX_LAYOUT_BYTES):
    data = sys.stdin.read(limit + 1)
    if len(data) > limit:
        fail("input too large")
    try:
        return json.loads(data)
    except ValueError as e:
        fail(f"not valid JSON: {e}")


def available_icons():
    names = set()
    for d in (ICON_SOURCES, USER_ICONS):
        try:
            names.update(f[:-4] for f in os.listdir(d) if f.endswith(".svg"))
        except OSError:
            pass
    out = []
    for n in sorted(names):
        try:
            with open(icon_source(n), encoding="utf-8") as f:
                svg = f.read(65536)
        except (OSError, TypeError):
            continue
        vb = re.search(r'viewBox="([-0-9. ]+)"', svg)
        # The editor draws icons as vector shapes in any colour, so it needs
        # the raw path data rather than a file.
        out.append({"name": n, "viewBox": [float(v) for v in (vb.group(1) if vb else "0 -960 960 960").split()],
                    "paths": re.findall(r'<path[^>]*\sd="([^"]+)"', svg)})
    return out


def cmd_editor_data():
    rules = load_rules()
    layouts = []
    for lid, (path, source) in layout_paths().items():
        try:
            layouts.append({"id": lid, "source": source, "builtin": os.path.isfile(
                os.path.join(BUILTIN_LAYOUTS, lid + ".json")), "layout": read_layout(lid)})
        except (OSError, ValueError) as e:
            layouts.append({"id": lid, "source": source, "error": str(e)})
    try:
        clients = json.loads(subprocess.run(["hyprctl", "clients", "-j"], capture_output=True,
                                            text=True, timeout=3).stdout or "[]")
        running = sorted({c.get("class") for c in clients if c.get("class")})
    except (OSError, subprocess.SubprocessError, ValueError):
        running = []
    print(json.dumps({
        "layouts": layouts,
        "icons": available_icons(),
        "palette": palette(),
        "roles": list(ROLES),
        "keys": KEY_PRESETS,
        "shortcuts": omarchy_shortcuts(),
        "apps": desktop_apps(),
        "rules": {k: rules.get(k) for k in ("default", "rules", "follow", "emptyDefault", "shortcut")},
        "shortcutDefault": DEFAULT_SHORTCUT,
        "runningApps": running,
        "userLayoutsDir": USER_LAYOUTS,
    }, ensure_ascii=False))


def clean_layout(L):
    if not isinstance(L, dict):
        fail("layout must be a JSON object")
    L = {k: v for k, v in L.items() if k in ("name", "description", "mediaLayerDefault", "showButtonOutlines",
                                             "adaptiveBrightness", "fontTemplate", "weatherUnit",
                                             "buttons", "fnLayer")}
    for row in ("buttons", "fnLayer"):
        L[row] = [b for b in (L.get(row) or []) if isinstance(b, dict)]
    return L


def cmd_save(lid):
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,47}", lid):
        fail("Layout ids use lowercase letters, digits, dots, dashes and underscores (up to 48).")
    L = assign_keys(clean_layout(read_stdin_json()), lid)
    errs = validate(expand(L, None))
    if errs:
        fail("Can't save: " + "; ".join(errs))
    was_live = read_live() is not None and lid in layout_ids() and \
        body(expand(read_layout(lid), load_weather())) == read_live()
    atomic_write(os.path.join(USER_LAYOUTS, lid + ".json"), json.dumps(L, indent=2, ensure_ascii=False) + "\n")
    if helper_ok():
        hypr_binds.cache_clear()
        sync_binds()
        if was_live:
            cmd_apply(lid)
    print(json.dumps({"id": lid, "layout": L}, ensure_ascii=False))


def cmd_delete(lid):
    p = os.path.join(USER_LAYOUTS, lid + ".json")
    if not os.path.isfile(p):
        fail(f"{lid!r} isn't one of your layouts (built-in layouts can't be deleted).")
    os.unlink(p)
    if helper_ok():
        sync_binds()


def cmd_try():
    L = assign_keys(clean_layout(read_stdin_json()))
    L = expand(L, load_weather())
    errs = validate(L)
    if errs:
        fail("Can't try this layout: " + "; ".join(errs))
    atomic_write(TRIAL, str(time.time() + 30) + "\n")
    sync_icons(extra=[L])
    push_config(render(L))


def cmd_restore():
    try:
        os.unlink(TRIAL)
    except OSError:
        pass
    live = read_live()
    if live is not None and helper_ok():
        sync_icons()
        push_config(render(live))


def cmd_save_rules():
    new = read_stdin_json()
    if not isinstance(new, dict):
        fail("rules must be a JSON object")
    rules = load_rules()
    if rules.get("error"):
        rules = dict(DEFAULT_RULES)
    ids = set(layout_ids())
    if "rules" in new:
        clean = []
        for i, r in enumerate(new["rules"] or [], 1):
            app, lay = str(r.get("app", "")).strip(), r.get("layout")
            if not app:
                continue
            try:
                re.compile(app)
            except re.error as e:
                fail(f"Rule {i}: the app pattern isn't valid ({e})")
            if lay not in ids:
                fail(f"Rule {i}: no layout named {lay!r}")
            clean.append({"app": app, "layout": lay})
        rules["rules"] = clean
    if "default" in new:
        if new["default"] not in ids:
            fail(f"No layout named {new['default']!r}")
        rules["default"] = new["default"]
    if "shortcut" in new:
        sc = str(new["shortcut"] or "").strip()
        if sc and not HYPR_KEY.match(sc):
            fail("The shortcut must look like SUPER + ALT + T")
        rules["shortcut"] = sc
    save_rules(rules)
    if helper_ok() and "shortcut" in new:
        sync_binds()


MUTATING = {"apply", "auto", "refresh-weather", "retheme", "colors", "follow", "empty-default", "migrate",
            "save", "delete", "try", "restore", "save-rules"}

if __name__ == "__main__":
    args = sys.argv[1:]
    if args and args[0] in MUTATING:
        _lock = take_lock()
    if args == ["list"]:
        cmd_list()
    elif len(args) == 2 and args[0] == "apply":
        cmd_apply(args[1])
        atomic_write(MANUAL, args[1] + "\n")
    elif args and args[0] == "auto" and len(args) <= 2:
        cmd_auto(args[1] if len(args) == 2 else "")
    elif args == ["refresh-weather"]:
        cmd_refresh_weather()
    elif args == ["retheme"]:
        cmd_retheme()
    elif len(args) == 2 and args[0] == "colors" and args[1] in ("default", "theme"):
        cmd_colors(args[1])
    elif len(args) == 2 and args[0] in ("follow", "empty-default") and args[1] in ("on", "off"):
        cmd_set_flag("follow" if args[0] == "follow" else "emptyDefault", args[1])
    elif len(args) == 2 and args[0] == "render":
        L = expand(read_layout(args[1]), load_weather())
        errs = validate(L)
        if errs:
            fail("\n".join(errs))
        print(render(L), end="")
    elif args == ["editor-data"]:
        cmd_editor_data()
    elif len(args) == 2 and args[0] == "save":
        cmd_save(args[1])
    elif len(args) == 2 and args[0] == "delete":
        cmd_delete(args[1])
    elif args == ["try"]:
        cmd_try()
    elif args == ["restore"]:
        cmd_restore()
    elif args == ["save-rules"]:
        cmd_save_rules()
    elif args == ["doctor"]:
        cmd_doctor()
    elif args == ["migrate"]:
        cmd_migrate()
    else:
        fail(__doc__.strip())
