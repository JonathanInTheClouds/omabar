{
  "name": "Capture",
  "description": "Region screenshot, screen recording (red; tap again to stop), copy text from the screen, scan a QR code, pick a colour.",
  "mediaLayerDefault": true,
  "showButtonOutlines": false,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "icon": "brightness_low",
      "tint": "foreground",
      "key": "BrightnessDown"
