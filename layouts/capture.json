    {
      "icon": "brightness_high",
      "tint": "foreground",
      "key": "BrightnessUp"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "icon": "screenshot_region",
      "tint": "accent",
      "key": "F17",
      "hyprKey": "code:195",
      "command": "omarchy capture screenshot region"
    },
    {
      "icon": "radio_button_checked",
      "tint": "danger",
      "key": "F18",
      "hyprKey": "code:196",
      "command": "omarchy capture screenrecording"
