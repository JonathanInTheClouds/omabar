{
  "name": "Browser",
  "description": "Back, forward, reload, tab left and right, new tab, reopen a closed tab, close tab, the address bar and find.",
  "mediaLayerDefault": true,
  "showButtonOutlines": false,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "icon": "arrow_back",
      "tint": "foreground",
      "key": [
        "LeftAlt",
        "Left"
      ]
    },
    {
      "icon": "arrow_forward",
      "tint": "foreground",
      "key": [
        "LeftAlt",
        "Right"
      ]
    },
    {
      "icon": "refresh",
      "tint": "foreground",
      "key": [
        "LeftCtrl",
        "R"
      ]
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "icon": "keyboard_double_arrow_left",
      "tint": "foreground",
