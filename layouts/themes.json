{
  "name": "Themes",
  "description": "Switch Omarchy themes by name, plus the background switcher and the theme menu.",
  "mediaLayerDefault": true,
  "showButtonOutlines": true,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "text": "󰸉 bg",
      "key": [
        "LeftMeta",
        "LeftCtrl",
        "Space"
      ]
    },
    {
      "text": "󰏘 themes",
      "key": [
        "LeftMeta",
        "LeftShift",
        "LeftCtrl",
        "Space"
      ]
    },
    {
