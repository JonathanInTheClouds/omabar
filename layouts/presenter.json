{
  "name": "Presenter",
  "description": "First, previous, next and last slide, fullscreen, blank the screen and mirror to a projector, with the clock and battery.",
  "mediaLayerDefault": true,
  "showButtonOutlines": true,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "text": "󰘀 first",
      "key": "Home",
      "stretch": 2
    },
    {
      "text": "󰅁 prev",
      "key": "Left",
      "stretch": 2
    },
    {
      "text": "󰅂 next",
      "key": "Right",
      "stretch": 3
    },
    {
      "text": "󰘁 last",
      "key": "End",
      "stretch": 2
    },
    {
      "text": "󰊓 full",
      "key": "F11",
      "stretch": 2
    },
    {
      "text": "󰶐 blank",
      "key": "B",
      "stretch": 2
    },
    {
      "text": "󱒃 mirror",
      "stretch": 2,
      "key": [
        "LeftCtrl",
        "LeftAlt",
        "LeftShift",
        "F20"
      ],
      "hyprKey": "CTRL + ALT + SHIFT + code:198",
      "command": "omarchy hyprland monitor internal mirror toggle"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "time": "%-I:%M %p",
      "stretch": 2
    },
    {
      "battery": "both",
      "stretch": 2
    }
  ],
  "fnLayer": [
    {
      "icon": "brightness_low",
      "tint": "white",
      "key": "BrightnessDown"
    },
    {
      "icon": "brightness_high",
      "tint": "white",
      "key": "BrightnessUp"
    },
    {
      "icon": "volume_off",
      "tint": "white",
      "key": "Mute"
    },
    {
      "icon": "volume_down",
      "tint": "white",
      "key": "VolumeDown"
    },
    {
      "icon": "volume_up",
      "tint": "white",
      "key": "VolumeUp"
    },
    {
      "spacer": true,
      "stretch": 1
    },
