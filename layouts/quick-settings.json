{
  "name": "Quick Settings",
  "description": "Night light, idle lock, Bluetooth, silence notifications, hide the top bar, window gaps and display mirroring.",
  "mediaLayerDefault": true,
  "showButtonOutlines": false,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "icon": "nightlight",
      "tint": "foreground",
      "key": [
        "LeftMeta",
        "LeftCtrl",
        "N"
      ]
    },
    {
      "icon": "lock_clock",
      "tint": "foreground",
      "key": [
        "LeftMeta",
        "LeftCtrl",
        "I"
      ]
    },
    {
      "icon": "bluetooth",
      "tint": "foreground",
      "key": [
        "LeftCtrl",
        "LeftAlt",
        "LeftShift",
        "F19"
      ],
      "hyprKey": "CTRL + ALT + SHIFT + code:197",
      "command": "omarchy bluetooth power toggle"
    },
    {
      "icon": "notifications_off",
      "tint": "foreground",
      "key": [
        "LeftMeta",
        "LeftCtrl",
        "Comma"
      ]
    },
    {
      "icon": "web_asset",
      "tint": "foreground",
      "key": [
        "LeftMeta",
        "LeftShift",
        "Space"
      ]
    },
    {
      "icon": "padding",
      "tint": "foreground",
      "key": [
        "LeftMeta",
        "LeftShift",
        "Backspace"
      ]
    },
    {
      "icon": "screen_share",
      "tint": "foreground",
      "key": [
        "LeftCtrl",
        "LeftAlt",
        "LeftShift",
        "F20"
      ],
      "hyprKey": "CTRL + ALT + SHIFT + code:198",
      "command": "omarchy hyprland monitor internal mirror toggle"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "icon": "brightness_low",
      "tint": "foreground",
      "key": "BrightnessDown"
    },
    {
      "icon": "brightness_high",
      "tint": "foreground",
      "key": "BrightnessUp"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "time": "%-I:%M %p",
      "stretch": 2
    },
    {
      "battery": "both",
      "stretch": 2
    }
  ],
  "fnLayer": [
    {
      "icon": "fast_rewind",
      "tint": "foreground",
      "key": "PreviousSong"
    },
    {
      "icon": "play_pause",
      "tint": "foreground",
