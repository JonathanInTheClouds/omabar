      "tint": "foreground",
      "key": "Mute"
    },
    {
      "icon": "volume_down",
      "tint": "foreground",
      "key": "VolumeDown"
    },
    {
      "icon": "volume_up",
      "tint": "foreground",
      "key": "VolumeUp"
    },
    {
      "icon": "mic_off",
      "tint": "foreground",
      "key": "MicMute"
