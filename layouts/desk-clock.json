{
  "name": "Desk Clock",
  "description": "Weather, the date and the time centred with room around them, and the battery. Calm enough for the desk at night.",
  "mediaLayerDefault": true,
  "showButtonOutlines": false,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "weather": "icon"
    },
    {
      "weather": "temp"
    },
    {
      "spacer": true,
      "stretch": 2
    },
    {
      "time": "%a %b %-d",
      "stretch": 3
    },
    {
      "time": "%-I:%M %p",
      "stretch": 3
    },
    {
      "spacer": true,
      "stretch": 2
    },
    {
      "battery": "both",
      "stretch": 2
    }
  ],
  "fnLayer": [
    {
      "icon": "brightness_low",
      "tint": "foreground",
      "key": "BrightnessDown"
    },
    {
      "icon": "brightness_high",
      "tint": "foreground",
      "key": "BrightnessUp"
    },
    {
      "icon": "play_pause",
      "tint": "foreground",
      "key": "PlayPause"
    },
    {
      "icon": "volume_off",
      "tint": "foreground",
      "key": "Mute"
    },
    {
      "icon": "volume_down",
      "tint": "foreground",
      "key": "VolumeDown"
    },
    {
      "icon": "volume_up",
      "tint": "foreground",
      "key": "VolumeUp"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "text": "F1",
      "key": "F1"
    },
    {
      "text": "F2",
      "key": "F2"
    },
    {
      "text": "F3",
      "key": "F3"
    },
    {
      "text": "F4",
      "key": "F4"
    },
    {
      "text": "F5",
      "key": "F5"
    },
    {
      "text": "F6",
      "key": "F6"
    },
    {
      "text": "F7",
      "key": "F7"
    },
    {
      "text": "F8",
      "key": "F8"
    },
    {
      "text": "F9",
      "key": "F9"
    },
    {
      "text": "F10",
