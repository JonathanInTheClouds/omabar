{
  "name": "Dev",
  "description": "Workspaces 1–4, then terminal, editor, lazygit, lazydocker and browser in the accent colour, with media and the clock.",
  "mediaLayerDefault": true,
  "showButtonOutlines": false,
  "adaptiveBrightness": true,
  "fontTemplate": "JetBrainsMono Nerd Font:bold",
  "buttons": [
    {
      "text": "1",
      "key": [
        "LeftMeta",
        "Num1"
      ]
    },
    {
      "text": "2",
      "key": [
        "LeftMeta",
        "Num2"
      ]
    },
    {
      "text": "3",
      "key": [
        "LeftMeta",
        "Num3"
      ]
    },
    {
      "text": "4",
      "key": [
        "LeftMeta",
        "Num4"
      ]
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "icon": "terminal",
      "tint": "accent",
      "key": "F13",
      "hyprKey": "code:191",
      "command": "omarchy-launch-terminal"
    },
    {
      "icon": "code",
      "tint": "accent",
      "key": "F24",
      "hyprKey": "code:202",
      "command": "omarchy-launch-editor"
    },
    {
      "icon": "commit",
      "tint": "accent",
      "key": "Prog1",
      "hyprKey": "code:156",
      "command": "omarchy-launch-tui lazygit"
    },
    {
      "icon": "deployed_code",
      "tint": "accent",
      "key": "Prog2",
      "hyprKey": "code:157",
      "command": "omarchy-launch-docker-tui"
    },
    {
      "icon": "public",
      "tint": "accent",
      "key": "F14",
      "hyprKey": "code:192",
      "command": "omarchy-launch-browser"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "icon": "play_pause",
      "tint": "foreground",
      "key": "PlayPause"
    },
    {
      "icon": "volume_down",
      "tint": "foreground",
      "key": "VolumeDown"
    },
    {
      "icon": "volume_up",
      "tint": "foreground",
      "key": "VolumeUp"
    },
    {
      "spacer": true,
      "stretch": 1
    },
    {
      "time": "%-I:%M %p",
      "stretch": 2
    }
  ],
  "fnLayer": [
    {
      "icon": "brightness_low",
      "tint": "foreground",
      "key": "BrightnessDown"
    },
    {
      "icon": "brightness_high",
      "tint": "foreground",
      "key": "BrightnessUp"
    },
    {
      "icon": "folder",
      "tint": "accent",
      "key": "F15",
      "hyprKey": "code:193",
      "command": "omarchy-launch-nautilus"
    },
    {
      "icon": "mic_off",
      "tint": "foreground",
      "key": "MicMute"
    },
    {
      "icon": "fast_rewind",
      "tint": "foreground",
      "key": "PreviousSong"
    },
    {
      "icon": "fast_forward",
      "tint": "foreground",
      "key": "NextSong"
    },
    {
